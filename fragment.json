{
  "structure": {
    "type": "module"
  },
  "database": {
    "type": "mysql",
    "host": "${DATABASE_HOST}",
    "port": "${DATABASE_PORT}",
    "username": "${DATABASE_USER}",
    "password": "${DATABASE_PASSWORD}",
    "database": "${DATABASE_NAME}",
    "synchronize": true,
    "logging": false,
    "entities": [
      "src/**/*.entity.ts"
    ],
    "migrations": [
      "src/migrations/**/*.ts"
    ]
  },
  "mail": {
    "default": "primary",
    "mailers": {
      "primary": {
        "driver": "smtp",
        "host": "${MAIL_HOST}",
        "port": "${MAIL_PORT}",
        "username": "${MAIL_USERNAME}",
        "password": "${MAIL_PASSWORD}",
        "from": "${MAIL_FROM}"
      }
    }
  },
  "jobs": {
    "enabled": true,
    "timezone": "${JOBS_TZ}"
  }
}
